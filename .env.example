# PostgreSQL (usado por Docker Compose y Prisma)
POSTGRES_USER=ludio_user
POSTGRES_PASSWORD=ludio_secure_password
POSTGRES_DB=ludio_db
DATABASE_URL=postgresql://ludio_user:ludio_secure_password@localhost:5432/ludio_db

# NextAuth / Auth.js (generar uno seguro en producción, ej: openssl rand -base64 32)
AUTH_SECRET="change_me_to_a_secure_random_secret"

# IGDB / Twitch API (https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
