# PostgreSQL:
# - Producción (NAS / instancia común): usa host.docker.internal:<PUERTO> (ej. 2020)
# - Desarrollo local (docker-compose.local.yml): usa localhost:5432
DATABASE_URL=postgresql://flux_user:flux_secure_password@host.docker.internal:2020/flux_db

# Solo usados por docker-compose.local.yml en desarrollo local
POSTGRES_USER=flux_user
POSTGRES_PASSWORD=flux_secure_password
POSTGRES_DB=flux_db

# NextAuth / Auth.js (generar uno seguro en producción, ej: openssl rand -base64 32)
AUTH_SECRET="change_me_to_a_secure_random_secret"

# Puertos en producción (5020 para la app)
PORT=5020
STUDIO_PORT=5022

# Usuario inicial creado por el seed (opcional)
ADMIN_EMAIL=admin@flux.app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# IGDB / Twitch API (https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
